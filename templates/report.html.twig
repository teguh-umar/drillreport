{#
 # DR Drill Report — printable report (ISO 22398 / NIST SP 800-84 AAR/IP).
 # Rendered by front/report.php:
 #   TemplateRenderer::getInstance()->display('@drillreport/report.html.twig', {report, print_mode})
 #
 # Every value comes from Report::build() and is emitted through Twig
 # autoescaping — no |raw anywhere.
 #}
{% set d = report.drill %}
{% set S = report.sections %}
{% set H = report.headings %}
{% set sev_color = {'critical': '#b02a37', 'high': '#b02a37', 'medium': '#b5850b', 'low': '#6c757d', 'info': '#6c757d'} %}
{% macro met(v) %}
    {%- if v is null -%}<span class="dr-muted">&mdash;</span>
    {%- elseif v -%}<span class="dr-ok">&check; {{ __('Yes') }}</span>
    {%- else -%}<span class="dr-bad">&times; {{ __('No') }}</span>
    {%- endif -%}
{% endmacro %}
{% import _self as m %}

<div class="drillreport-report {{ print_mode ? 'dr-print' : '' }}">

    <style>
        @page { size: A4 portrait; margin: 14mm; }
        .drillreport-report {
            max-width: 900px; margin: 0 auto; padding: 0 1rem;
            font-family: Georgia, "Times New Roman", serif;
            color: #1f2733; line-height: 1.5; font-size: 11pt;
            /* keep header fills / row shading when printed */
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }
        .drillreport-report * {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }
        .drillreport-report h1 { font-size: 20pt; font-weight: 700; margin: .2rem 0 .1rem; color: #1f2733; }
        .drillreport-report .dr-subtitle { font-size: 13pt; color: #6c757d; margin-bottom: 1rem; }
        .drillreport-report h2 {
            font-size: 15pt; font-weight: 700; color: #3d6ea5;
            margin: 1.6rem 0 .5rem; padding-bottom: .15rem;
            border-bottom: 1px solid #d7dee7;
        }
        .drillreport-report h3 { font-size: 12pt; font-weight: 700; color: #3d6ea5; margin: 1rem 0 .35rem; }
        .drillreport-report p { margin: .35rem 0; }
        .drillreport-report .dr-narrative { white-space: pre-wrap; }
        .drillreport-report .dr-muted { color: #6c757d; }
        .drillreport-report .dr-ok  { color: #1a7f37; }
        .drillreport-report .dr-bad { color: #b02a37; }
        .drillreport-report table { width: 100%; border-collapse: collapse; margin: .5rem 0 1rem; font-size: 10.5pt; }
        .drillreport-report th, .drillreport-report td {
            border: 1px solid #c9d2dd; padding: .35rem .55rem; text-align: left; vertical-align: top;
        }
        .drillreport-report thead th {
            background: #2f3b52 !important; color: #fff !important; font-weight: 700;
            border-color: #2f3b52 !important;
        }
        .drillreport-report .dr-kv td:first-child { width: 12rem; color: #55627a; font-weight: 700; }
        .drillreport-report ul, .drillreport-report ol { margin: .3rem 0 .3rem 1.2rem; padding: 0; }
        .drillreport-report li { margin: .15rem 0; }
        .drillreport-report .dr-finding { margin: .9rem 0; }
        .drillreport-report .dr-finding-head { font-weight: 700; }
        .drillreport-report .dr-finding-meta { color: #6c757d; font-style: italic; font-size: 10pt; margin: .1rem 0 .3rem; }
        .drillreport-report .dr-sev { font-weight: 700; }
        .drillreport-report .dr-toolbar { margin-bottom: 1rem; }
        .drillreport-report .dr-footnote {
            margin-top: 2rem; padding-top: .6rem; border-top: 1px solid #d7dee7;
            color: #6c757d; font-style: italic; font-size: 9.5pt;
        }

        @media print {
            /* strip GLPI 11 chrome (the top header already carries d-print-none) */
            aside.navbar-vertical, .sidebar, [data-testid="sidebar"],
            .navbar.secondary-bar, #debug-toolbar-applet, [id^="debug-toolbar"],
            .debug-toolbar, #maintenance-float, #impersonate-banner,
            footer.footer, .glpi-footer { display: none !important; }
            body, .page, .page-wrapper, .page-body, main#page, #page.legacy {
                display: block !important; margin: 0 !important; padding: 0 !important;
                width: 100% !important; max-width: none !important; overflow: visible !important;
            }
            .drillreport-report { max-width: none; padding: 0; margin: 0; }
            .drillreport-report .dr-no-print { display: none !important; }
            .drillreport-report h2 { break-after: avoid; }
            .drillreport-report thead { display: table-header-group; }
            .drillreport-report thead th {
                background: #2f3b52 !important; color: #fff !important;
                -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important;
            }
            .drillreport-report .dr-finding, .drillreport-report tr { break-inside: avoid; }
            .drillreport-report a { color: inherit; text-decoration: none; }
        }
    </style>

    <div class="d-flex align-items-center gap-2 dr-toolbar dr-no-print">
        <a href="{{ path('/plugins/drillreport/front/drill.form.php', {'id': d.id}) }}" class="btn btn-outline-secondary btn-sm">
            <i class="ti ti-arrow-left"></i> {{ __('Back to drill', 'drillreport') }}
        </a>
        <button type="button" class="btn btn-primary btn-sm ms-auto" onclick="window.print();">
            <i class="ti ti-printer"></i> {{ __('Print / Save as PDF', 'drillreport') }}
        </button>
    </div>

    {# ---------------------------------------------------------------- Header #}
    <h1>{{ d.is_sample ? '[SAMPLE] ' }}{{ __('Disaster Recovery Drill Report', 'drillreport')|upper }}</h1>
    <div class="dr-subtitle">{{ d.name_clean }}</div>

    <table>
        <thead>
            <tr>
                <th>{{ __('Entity') }}</th>
                <th>{{ __('Date', 'drillreport') }}</th>
                <th>{{ __('Result', 'drillreport') }}</th>
                <th>{{ __('Status') }}</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>{{ d.entity }}</td>
                <td>{{ d.date_drill ?: '—' }}</td>
                <td class="{{ d.result_key == 'fail' ? 'dr-bad' : (d.result_key == 'pass' ? 'dr-ok' : '') }}">
                    {{ d.overall_result|upper }}
                </td>
                <td>{{ d.status }}</td>
            </tr>
        </tbody>
    </table>

    {# ------------------------------------------------ 1. Executive Summary #}
    {% if 'summary' in S %}
        <h2>{{ H.summary }}</h2>
        <p class="dr-narrative">{{ d.executive_summary ?: __('(not provided)', 'drillreport') }}</p>
        {% if d.lessons_learned %}
            <h3>{{ __('Lessons Learned', 'drillreport') }}</h3>
            <p class="dr-narrative">{{ d.lessons_learned }}</p>
        {% endif %}
    {% endif %}

    {# ------------------------------------------------ 2. Scenario Overview #}
    {% if 'overview' in S %}
        <h2>{{ H.overview }}</h2>
        <table class="dr-kv">
            <tr><td>{{ __('DR scenario', 'drillreport') }}</td><td>{{ d.scenario ?: '—' }}</td></tr>
            <tr><td>{{ __('Test type', 'drillreport') }}</td><td>{{ d.test_type ?: '—' }}</td></tr>
            <tr><td>{{ __('Scope', 'drillreport') }}</td><td class="dr-narrative">{{ d.scope_summary ?: '—' }}</td></tr>
            <tr><td>{{ __('Drill coordinator', 'drillreport') }}</td><td>{{ d.coordinator ?: '—' }}</td></tr>
            <tr><td>{{ __('Group in charge') }}</td><td>{{ d.group_in_charge ?: ('— ' ~ __('(not filled in)', 'drillreport')) }}</td></tr>
        </table>
        {% if report.objectives|length %}
            <p><strong>{{ __('Objectives tested', 'drillreport') }}:</strong></p>
            <ul>
                {% for o in report.objectives %}<li>{{ o.name }}</li>{% endfor %}
            </ul>
        {% elseif d.objectives_text %}
            <p><strong>{{ __('Objectives', 'drillreport') }}:</strong></p>
            <p class="dr-narrative">{{ d.objectives_text }}</p>
        {% endif %}
    {% endif %}

    {# ------------------------------------------------ 3. Systems in Scope #}
    {% if 'scope' in S %}
        {% set dr = report.has_dr_target %}
        {% set cols = 2 + (report.show_criticity ? 1 : 0) + (dr ? 1 : 0) + 1 %}
        <h2>{{ H.scope }}</h2>
        <table>
            <thead><tr>
                <th>{{ __('Asset') }}</th>
                <th>{{ __('Type') }}</th>
                {% if dr %}<th>{{ __('DR failover target', 'drillreport') }}</th>{% endif %}
                {% if report.show_criticity %}<th>{{ __('Business Criticality') }}</th>{% endif %}
                <th>{{ __('Recovery Order', 'drillreport') }}</th>
            </tr></thead>
            <tbody>
            {% for it in report.items %}
                <tr>
                    <td>{{ it.name }}</td>
                    <td>{{ it.type_name }}</td>
                    {% if dr %}<td>{{ it.dr_target ?: '—' }}</td>{% endif %}
                    {% if report.show_criticity %}
                        <td>{{ it.criticity ?: ('— ' ~ __('(not filled in)', 'drillreport')) }}</td>
                    {% endif %}
                    <td>
                        {{- it.order ?? '—' }}
                        ({{ it.recovered ? __('recovered', 'drillreport') : __('not recovered', 'drillreport') }})
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="{{ cols }}" class="dr-muted">{{ __('No systems recorded', 'drillreport') }}</td></tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}

    {# ------------------------------------------------------- 4. Timeline #}
    {% if 'timeline' in S %}
        <h2>{{ H.timeline }}</h2>
        {% if report.has_timeline %}
            <table>
                <thead><tr><th>{{ __('Milestone', 'drillreport') }}</th><th>{{ __('Time', 'drillreport') }}</th></tr></thead>
                <tbody>
                    <tr><td>{{ __('Disaster declared', 'drillreport') }}</td><td>{{ d.declaration_time ?: '—' }}</td></tr>
                    <tr><td>{{ __('Service recovered', 'drillreport') }}</td><td>{{ d.recovery_time ?: '—' }}</td></tr>
                    <tr><td>{{ __('Validation complete', 'drillreport') }}</td><td>{{ d.validation_time ?: '—' }}</td></tr>
                    {% if d.duration_minutes is not null %}
                        <tr><td>{{ __('Actual recovery duration', 'drillreport') }}</td><td>{{ d.duration_minutes }} {{ __('minutes', 'drillreport') }}</td></tr>
                    {% endif %}
                </tbody>
            </table>
        {% else %}
            <p class="dr-muted">{{ __('The timeline fields were not filled in on the drill form.', 'drillreport') }}</p>
        {% endif %}
    {% endif %}

    {# --------------------------------------- 5. RTO / RPO — Target vs Actual #}
    {% if 'rto_rpo' in S %}
        <h2>{{ H.rto_rpo }}</h2>
        <h3>{{ __('Overall Summary', 'drillreport') }}</h3>
        <table>
            <thead><tr>
                <th>{{ __('Metric', 'drillreport') }}</th>
                <th>{{ __('Target (min)', 'drillreport') }}</th>
                <th>{{ __('Actual (min)', 'drillreport') }}</th>
                <th>{{ __('Met?', 'drillreport') }}</th>
            </tr></thead>
            <tbody>
                <tr>
                    <td>{{ __('RTO — overall', 'drillreport') }}</td>
                    <td>{{ d.rto_target ?? '—' }}</td>
                    <td>{{ d.rto_actual ?? '—' }}</td>
                    <td>{{ m.met(d.rto_met) }}</td>
                </tr>
                <tr>
                    <td>{{ __('RPO — overall', 'drillreport') }}</td>
                    <td>{{ d.rpo_target ?? '—' }}</td>
                    <td>{{ d.rpo_actual ?? '—' }}</td>
                    <td>{{ m.met(d.rpo_met) }}</td>
                </tr>
            </tbody>
        </table>
        {% if d.rto_from_activities %}
            <p class="dr-muted">
                {{ __('RTO figures are the sum of the activity target / actual durations', 'drillreport') }}
                ({{ d.obj_target_total ?? '—' }} / {{ d.obj_actual_total ?? '—' }} {{ __('min', 'drillreport') }}).
            </p>
        {% endif %}

        {% if report.items|length %}
            <h3>{{ __('Per System', 'drillreport') }}</h3>
            <table>
                <thead><tr>
                    <th>{{ __('Asset') }}</th>
                    <th>{{ __('RTO Target/Actual', 'drillreport') }}</th>
                    <th>{{ __('RTO Met?', 'drillreport') }}</th>
                    <th>{{ __('RPO Target/Actual', 'drillreport') }}</th>
                </tr></thead>
                <tbody>
                {% for it in report.items %}
                    <tr>
                        <td>{{ it.name }}</td>
                        <td>{{ it.rto_target ?? '—' }} / {{ it.rto_actual ?? '—' }}</td>
                        <td>{{ m.met(it.rto_met) }}</td>
                        <td>{{ it.rpo_target ?? '—' }} / {{ it.rpo_actual ?? '—' }}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}

        {% if d.data_loss_summary %}
            <p><strong>{{ __('Data loss', 'drillreport') }}:</strong> {{ d.data_loss_summary }}</p>
        {% endif %}
    {% endif %}

    {# --------------------------------------------- 6. Objectives Assessment #}
    {% if 'objectives' in S %}
        {% set any_time = report.has_objective_time %}
        {% set ev = report.has_objective_evidence %}
        {% set ocols = 2 + (any_time ? 2 : 0) + (ev ? 1 : 0) %}
        <h2>{{ H.objectives }}</h2>
        <table>
            <thead><tr>
                <th>{{ __('Objective / activity', 'drillreport') }}</th>
                {% if any_time %}
                    <th>{{ __('Target (min)', 'drillreport') }}</th>
                    <th>{{ __('Actual (min)', 'drillreport') }}</th>
                {% endif %}
                <th>{{ __('Result', 'drillreport') }}</th>
                {% if ev %}<th>{{ __('Evidence', 'drillreport') }}</th>{% endif %}
                <th>{{ __('Comment') }}</th>
            </tr></thead>
            <tbody>
            {% for o in report.objectives %}
                <tr>
                    <td>{{ o.name }}</td>
                    {% if any_time %}
                        <td>{{ o.target ?? '—' }}</td>
                        <td class="{% if o.target and o.actual is not null %}{{ o.actual <= o.target ? 'dr-ok' : 'dr-bad' }}{% endif %}">
                            {{- o.actual ?? '—' -}}
                        </td>
                    {% endif %}
                    <td class="{{ o.result_key == 'met' ? 'dr-ok' : (o.result_key == 'not_met' ? 'dr-bad' : '') }}">{{ o.result }}</td>
                    {% if ev %}<td>{{ o.evidence_ref ?: '—' }}</td>{% endif %}
                    <td class="dr-narrative">{{ o.comment }}</td>
                </tr>
            {% else %}
                <tr><td colspan="{{ ocols }}" class="dr-muted">{{ __('No objectives recorded', 'drillreport') }}</td></tr>
            {% endfor %}
            {% if any_time and (report.drill.obj_target_total or report.drill.obj_actual_total) %}
                <tr>
                    <th>{{ __('Total', 'drillreport') }}</th>
                    <th>{{ report.drill.obj_target_total ?? '—' }}</th>
                    <th>{{ report.drill.obj_actual_total ?? '—' }}</th>
                    <th colspan="{{ ocols - 3 }}"></th>
                </tr>
            {% endif %}
            </tbody>
        </table>
    {% endif %}

    {# ------------------------------------ 7. Findings & Improvement Plan #}
    {% if 'findings' in S %}
        <h2>{{ H.findings }}</h2>
        <p class="dr-finding-meta">
            {% if report.evidence|length %}
                {{ __('Evidence', 'drillreport') }}:
                {% for e in report.evidence %}{{ e.name }}{{ not loop.last ? '; ' }}{% endfor %}
            {% else %}
                {{ __('Evidence: no documents attached to this drill.', 'drillreport') }}
            {% endif %}
        </p>
        {% for a in report.findings %}
            <div class="dr-finding">
                <div class="dr-finding-head">
                    <span class="dr-sev" style="color: {{ sev_color[a.severity_key] ?? '#6c757d' }}">{{ a.severity|upper }}</span>
                    {{ a.name }}
                </div>
                <div class="dr-finding-meta">
                    {{ __('Status') }}: {{ a.status }}
                    {%- if a.date_due %} &middot; {{ __('Due') }} {{ a.date_due }}{% endif %}
                    {%- if a.category %} &middot; {{ a.category }}{% endif %}
                    {%- if a.owner %} &middot; {{ __('Owner') }}: {{ a.owner }}{% endif %}
                    {%- if a.rr_code %} &middot; {{ __('Risk Register', 'drillreport') }}: {{ a.rr_code }}{% endif %}
                </div>
                {% if a.content %}<p><strong>{{ __('Observation', 'drillreport') }}:</strong> {{ a.content }}</p>{% endif %}
                {% if a.cause %}<p><strong>{{ __('Root cause', 'drillreport') }}:</strong> {{ a.cause }}</p>{% endif %}
                {% if a.recommendations|length %}
                    <p><strong>{{ __('Recommendation', 'drillreport') }}:</strong></p>
                    <ul>{% for r in a.recommendations %}<li>{{ r }}</li>{% endfor %}</ul>
                {% endif %}
            </div>
        {% else %}
            <p class="dr-muted">{{ __('No findings recorded', 'drillreport') }}</p>
        {% endfor %}
    {% endif %}

    {# ------------------------------------------- 8. Remediation Summary #}
    {% if 'remediation' in S and report.findings|length %}
        <h2>{{ H.remediation }}</h2>
        <table>
            <thead><tr>
                <th>{{ __('Severity') }}</th>
                <th>{{ __('Finding', 'drillreport') }}</th>
                <th>{{ __('Due Date', 'drillreport') }}</th>
                <th>{{ __('Status') }}</th>
            </tr></thead>
            <tbody>
            {% for a in report.findings %}
                <tr>
                    <td style="color: {{ sev_color[a.severity_key] ?? '#6c757d' }}; font-weight: 700;">{{ a.severity }}</td>
                    <td>{{ a.name }}</td>
                    <td>{{ a.date_due ?: '—' }}</td>
                    <td>{{ a.status }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    {% endif %}

    {# ------------------------------------------------------- 9. Approval #}
    {% if 'approval' in S %}
        <h2>{{ H.approval }}</h2>
        <table class="dr-kv">
            <tr><td>{{ __('Status') }}</td><td>{{ d.status }}</td></tr>
            <tr><td>{{ __('Approved by', 'drillreport') }}</td><td>{{ d.approved_by ?: ('— ' ~ __('(not yet approved)', 'drillreport')) }}</td></tr>
            <tr><td>{{ __('Approval date', 'drillreport') }}</td><td>{{ d.approval_date ?: '—' }}</td></tr>
        </table>
    {% endif %}

    <div class="dr-footnote">
        {% if d.is_sample %}
            {{ __('This document is SAMPLE / demo data from the GLPI drillreport plugin, used to demonstrate the report format.', 'drillreport') }}
        {% endif %}
        {{ __('Structured after the After-Action Report / Improvement Plan (AAR/IP) framework, aligned with ISO 22398 & NIST SP 800-84.', 'drillreport') }}
    </div>

</div>
